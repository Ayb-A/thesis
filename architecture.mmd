%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#ffffff', 'primaryBorderColor': '#333333', 'clusterBkg': '#f9f9f9', 'clusterBorder': '#666666'}}}%%
graph TD
    classDef agentLayer fill:#e8f4f8,stroke:#2b7a78,stroke-width:2px;
    classDef midLayer fill:#fcf4e4,stroke:#d4a373,stroke-width:2px;
    classDef simLayer fill:#eef7ee,stroke:#3a5a40,stroke-width:2px;

    subgraph Agent["Agent Layer (MOPER)"]
        direction TB
        A_DWC(Dynamic Weight Controller)
        A_ACT(Actor Network)
        A_CRI(Dual-Head Critic)
        A_PER[(Weight-Aware PER Buffer)]

        A_DWC -.->|w_lat, w_eng| A_CRI
        A_DWC -.->|Context| A_PER
        A_ACT ==> A_PER
        A_CRI ==> A_PER
    end

    subgraph Middleware["Middleware Layer"]
        direction TB
        M_GYM(Gymnasium Environment Wrapper)
    end

    subgraph Simulation["Simulation Layer"]
        direction TB
        S_SIM(EdgeSimPy Infrastructure)
    end

    %% Core Feedback Loop
    M_GYM ==>|5D State Vector S_t| A_ACT
    M_GYM ==>|Reward Signals R_t| A_CRI
    
    A_ACT ==>|Continuous Action a_t| M_GYM
    
    S_SIM -.->|Hardware Telemetry| M_GYM
    M_GYM ==>|Discrete Task Allocation| S_SIM

    class Agent agentLayer;
    class Middleware midLayer;
    class Simulation simLayer;